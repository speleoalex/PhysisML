    "comment_+": "{noun} trovato.",
    "comment_=": "Parole italiane ma non la risposta attesa.",
    "comment_-": "Non riconoscibile o troppo lunga."
  },
  "encouragement": [
    "bravo!",
    "ottimo!",
    "perfetto!",
    "bene!",
    "benissimo!"
  ],
  "retry_prefix": "ancora. ",
  "steps": {
    "A": {
      "description": "Bridge L4->L5: aggettivo nella frase",
      "targets": [
        {
          "prompt": "com è il cane?",
          "expected": "il cane è grande.",
          "noun": "grande",
          "verb": "è",
          "adjective": "grande"
