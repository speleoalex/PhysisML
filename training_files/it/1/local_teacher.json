        {
          "prompt": "papà",
          "expected": "papà!",
          "noun": "papà"
        },
        {
          "prompt": "nonno",
          "expected": "nonno!",
          "noun": "nonno"
        },
        {
          "prompt": "nonna",
          "expected": "nonna!",
          "noun": "nonna"
        }
      ],
      "prompt_template": "di: {prompt}",
      "max_response_words": 3,
      "advance_after_successes": 3,
      "retry_after_failures": 4,
      "require_article": false
    },
    "C": {
      "description": "Saluti e risposte sì/no",
      "targets": [
        {
          "prompt": "ciao",
          "expected": "ciao!",
          "noun": "ciao"
        },
        {
          "prompt": "sì",
          "expected": "sì!",
          "noun": "sì"
        },
        {
          "prompt": "no",
          "expected": "no!",
          "noun": "no"
        },
        {
          "prompt": "bravo",
          "expected": "bravo!",
          "noun": "bravo"
