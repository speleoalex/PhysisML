          "article": "la",
          "noun": "mamma"
        },
        {
          "prompt": "il gatto",
          "expected": "il gatto!",
          "article": "il",
          "noun": "gatto"
        },
        {
          "prompt": "il latte",
          "expected": "il latte!",
          "article": "il",
          "noun": "latte"
        },
        {
          "prompt": "il sole",
          "expected": "il sole!",
          "article": "il",
