      "prompt_template": "di: {prompt}",
      "max_response_words": 3,
      "advance_after_successes": 3,
      "retry_after_failures": 4,
      "require_article": false
    },
    "D": {
      "description": "Identità — il modello conosce il proprio nome (parola singola)",
      "targets": [
        {
          "prompt": "come ti chiami?",
          "expected": "physisml!",
          "noun": "physisml"
        },
        {
          "prompt": "qual è il tuo nome?",
          "expected": "physisml!",
          "noun": "physisml"
        },
        {
          "prompt": "di il tuo nome",
          "expected": "physisml!",
          "noun": "physisml"
        },
        {
          "prompt": "chi sei?",
          "expected": "physisml!",
          "noun": "physisml"
        }
      ],
      "prompt_template": "{prompt}",
      "max_response_words": 4,
      "advance_after_successes": 3,
      "retry_after_failures": 4,
      "require_article": false,
      "require_verb": false,
      "require_adjective": false
    }
  },
  "evaluation": {
    "has_terminator_pattern": "[.!?]",
    "comment_+++": "{noun} con articolo e terminatore. Perfetto!",
    "comment_++": "{noun} presente, buona risposta.",
    "comment_+": "{noun} trovato ma risposta migliorabile.",
    "comment_=": "Qualcosa di italiano ma {noun} mancante.",
    "comment_-": "Risposta non riconoscibile o troppo lunga."
  },
  "encouragement": [
    "bravo!",
    "bene!",
    "ottimo!",
    "perfetto!",
    "benissimo!"
  ],
  "retry_prefix": "{prompt} {prompt}. "
}