# Secrets
.env

# Python cache
__pycache__/
*.py[cod]
.pytest_cache/

# Virtualenvs and runtime state
venv/
.venv/
*.pid
*.db

# Trained models and checkpoints (generated artifacts, can be multi-GB)
models/
*.pt
*.npz
*.bin
*.safetensors
*.gguf

# Test-generated checkpoints
tests/test_1/checkpoints/
dynamic_model/exp_a/checkpoints/
dynamic_model/exp_b/checkpoints/

# Session logs (generated during training)
*.jsonl
# ...but qa_pairs.jsonl is SOURCE, not a log: qa_corpus.txt is generated from
# it and is committed. Ignoring the source while tracking the derived file let
# the two drift — measured 2026-08-24: L1 and L2 corpora had been generated
# from an older pair set, so a fresh clone trained on different data than the
# machine that produced the results, with neither version declared canonical.
!training_files/**/qa_pairs.jsonl

# Raw corpus downloads (multi-GB)
corpus_raw/

# Editor / OS
.DS_Store
*.swp
*.swo

# Local agent/tool config (machine-specific paths, not portable)
.claude/

# Private notes (not published)
docs_internal/
diario/
CLAUDE.md
GEMINI.md
appunti.md

# Hugging Face upload folder (generated by scripts/export_hf.py)
hf_upload/
