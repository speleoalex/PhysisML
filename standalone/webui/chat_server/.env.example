# Server
PORT=8001
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5501,http://127.0.0.1:5501,http://localhost,http://localhost:80,http://127.0.0.1

# Paths (relative to chat_server/)
MODEL_PATH=../../model.pt
TOKENIZER_PATH=../../tokenizer.json
STANDALONE_DIR=../..

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/chat.db

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRE_HOURS=24

# Default admin (created at startup if no admin exists)
ADMIN_EMAIL=admin@physisml.local
ADMIN_PASSWORD=admin123

# Generation defaults
DEFAULT_MAX_TOKENS=80
DEFAULT_TEMPERATURE=0.8
DEFAULT_TOP_K=40

# Training (Train now)
TRAIN_LR=1e-5
TRAIN_STEPS_PER_SAMPLE=3
